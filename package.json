{
  "name": "booklike",
  "version": "1.2.0",
  "description": "Reader mode with book-like pagination. Dark mode, dictionary, epub export.",
  "license": "MIT",
  "homepage": "https://booklike.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fachkamera/booklike.git"
  },
  "bugs": {
    "url": "https://github.com/fachkamera/booklike/issues"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs --prod",
    "release": "node scripts/build-release.mjs",
    "build-dict": "node scripts/build-dict.mjs",
    "lint": "eslint src",
    "test": "node --test src/*.test.ts"
  },
  "keywords": [
    "chrome-extension",
    "reader-mode",
    "web-reader",
    "readability",
    "reading"
  ],
  "type": "module",
  "author": "Markus Mayer",
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.2.0",
    "chrome-types": "^0.1.439",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 110,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fflate": "^0.8.3"
  }
}
